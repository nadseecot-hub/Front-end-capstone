rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.uid == uid && request.resource.data.role in ['student', 'parent', 'tutor'];
      allow update: if owner(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    match /tutors/{uid} {
      allow read: if resource.data.isPublic == true || owner(uid);
      allow create, update: if owner(uid);
      allow delete: if false;
    }
    match /users/{uid}/savedTutors/{tutorId} { allow read, write: if owner(uid); }
    match /{document=**} { allow read, write: if false; }
  }
}
